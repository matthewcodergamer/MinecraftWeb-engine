{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Browser",
  "version": "26.3.1",
  "identifier": "com.matthewcodergamer.minecraftbrowser",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Java 26.3",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft Java 26.3 in a WebGPU WebView",
    "longDescription": "A Tauri v2 Android shell for the Minecraft Java 26.3 browser client. Requires Android 12+ and Android System WebView 121+ for WebGPU.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 263001
    }
  }
}
